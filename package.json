{
	"name": "oak",
	"version": "2.9.10",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev:turbo": "next dev --turbopack",
		"build": "next build",
		"clean": "rm -rf dist",
		"start": "next start",
		"lint": "next lint",
		"export": "next export",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "npx vite preview --outDir html",
		"show-tests": "vitest --ui",
		"format": "prettier --write \"**/*.{cjs,mjs,js,jsx,ts,tsx,css,md,json,html}\"",
		"format:check": "prettier --check \"**/*.{cjs,mjs,js,jsx,ts,tsx,css,md,json,html}\""
	},
	"dependencies": {
		"@popperjs/core": "^2.11.6",
		"@reduxjs/toolkit": "^2.5.0",
		"@tanstack/form-core": "1.33.5",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.103.2",
		"@tanstack/react-query-devtools": "^5.103.2",
		"@tanstack/router-devtools": "^1.167.2",
		"@tanstack/zod-form-adapter": "^0.42.1",
		"@vercel/analytics": "^1.1.1",
		"@vercel/speed-insights": "^1.1.0",
		"axios": "^1.20.0",
		"bootstrap": "5.3.3",
		"brace-expansion": "5.0.12",
		"css-loader": "7.1.5",
		"framer-motion": "13.4.1",
		"glob": "13.0.6",
		"gsap": "^3.15.0",
		"jquery": "^3.4.1",
		"micromatch": "^4.0.8",
		"minimatch": "^10.2.6",
		"next": "16.3.6",
		"picomatch": "^4.0.7",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-redux": "^8.1.3",
		"redux": "5.0.1",
		"redux-thunk": "3.1.0",
		"sass": "1.105.0",
		"scss-loader": "^0.0.1",
		"style-loader": "^3.3.2",
		"styled-components": "^6.5.3",
		"uuid": "14.0.2",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@tanstack/eslint-plugin-query": "^5.103.2",
		"@tanstack/react-router": "^1.170.38",
		"@tanstack/router-core": "^1.171.32",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "^16.0.1",
		"@testing-library/user-event": "^14.5.2",
		"@types/gsap": "^3.0.0",
		"@types/minimatch": "5.1.2",
		"@types/node": "^24.0.0",
		"@types/react": "~18.2.0",
		"@types/react-dom": "~18.2.0",
		"@types/react-helmet": "^6.1.11",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/ui": "5.0.1",
		"csstype": "^3.0.10",
		"dotenv": "^16.4.5",
		"eslint": "10.11.0",
		"eslint-config-next": "16.3.6",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"jsdom": "^25.0.0",
		"prettier": "3.9.8",
		"prop-types": "^15.8.1",
		"react-helmet": "^6.1.0",
		"react-router-dom": "7.18.4",
		"rollup-plugin-visualizer": "^5.12.0",
		"solid-js": "^1.9.15",
		"tiny-invariant": "^1.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vite-plugin-html-config": "^2.0.2",
		"vite-tsconfig-paths": "^5.0.1",
		"vitest": "5.0.1",
		"webpack": "5.111.1"
	},
	"resolutions": {
		"**/fast-uri": "^3.1.1",
		"**/minimatch": "^3.1.4",
		"micromatch/picomatch": "^2.3.2",
		"**/picomatch": "^4.0.7"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"prettier": {
		"arrowParens": "always",
		"printWidth": 100,
		"semi": true,
		"trailingComma": "all",
		"singleQuote": true,
		"jsxSingleQuote": true,
		"tabWidth": 4,
		"useTabs": true,
		"endOfLine": "auto",
		"overrides": [
			{
				"files": [
					"**/*.scss"
				],
				"options": {
					"parser": "scss"
				}
			}
		]
	}
}
